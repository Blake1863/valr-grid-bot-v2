[Unit]
Description=VALR CMS1/CMS2 Spot Bot (unified, Python)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/.openclaw/workspace/bots/cm-bot-spot-py
ExecStart=/usr/bin/python3 /home/admin/.openclaw/workspace/bots/cm-bot-spot-py/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/home/admin/.openclaw/workspace/bots/cm-bot-spot-py/logs/valr-cm-spot.stdout.log
StandardError=append:/home/admin/.openclaw/workspace/bots/cm-bot-spot-py/logs/valr-cm-spot.stderr.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
